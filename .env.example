# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Email пользователя, который автоматически получает права супер-администратора
# Можно указать один email или несколько через запятую в ADMIN_EMAILS:
ADMIN_EMAIL="vledahovic@gmail.com"
# ADMIN_EMAILS="admin@example.com,superadmin@example.com"

# ADMIN_PASSWORD: Мастер-пароль супер-администратора для безопасного развертывания (по умолчанию: 123456)
# При развертывании на веб-сервере задайте свой надежный секретный пароль:
ADMIN_PASSWORD="123456"

# TURSO / LibSQL: Удаленная база данных Turso
# Если TURSO_DATABASE_URL не задан, сервер использует локальный SQLite файл (file:database.sqlite)
TURSO_DATABASE_URL="libsql://your-database-name-organization.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# EMAIL DISPATCH: Два способа отправки писем — Resend API (HTTPS) и SMTP (Nodemailer)
# 1. Resend API (HTTPS порт 443) — рекомендуется для Render Free и облачных хостингов:
RESEND_API_KEY="re_123456789_placeholder_key"

# 2. SMTP EMAIL: Настройки классического SMTP-сервера (порты 465 или 587):
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@mafia-club.com"
SMTP_PASS="your-smtp-password-or-resend-key"
SMTP_FROM="\"Mafia Club\" <noreply@mafia-club.com>"
SMTP_SECURE="false"

# WEB PUSH (VAPID): Настройки push-уведомлений для Главного Администратора
# Сгенерировать пару ключей можно командой: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:vledahovic@gmail.com"

# CLOUDFLARE R2 (S3-Compatible Object Storage): Приватное хранилище объектов
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT=""
R2_BUCKET_NAME=""

