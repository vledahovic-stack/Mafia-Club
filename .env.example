# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Email пользователя, который автоматически получает права супер-администратора
# Можно указать один email или несколько через запятую в ADMIN_EMAILS:
ADMIN_EMAIL="vledahovic@gmail.com"
# ADMIN_EMAILS="admin@example.com,superadmin@example.com"

# ADMIN_PASSWORD: Мастер-пароль супер-администратора для безопасного развертывания (по умолчанию: 123456)
# При развертывании на веб-сервере задайте свой надежный секретный пароль:
ADMIN_PASSWORD="123456"

# TURSO / LibSQL: Удаленная база данных Turso
# Если TURSO_DATABASE_URL не задан, сервер использует локальный SQLite файл (file:database.sqlite)
TURSO_DATABASE_URL="libsql://your-database-name-organization.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# SMTP EMAIL: Настройки почтового сервера для отправки реальных писем с кодами подтверждения
# Поддерживается любой SMTP-провайдер (например, Yandex 360, Mail.ru, Gmail App Password, Brevo, SendGrid, Mailgun)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@mafia-club.com"
SMTP_PASS="your-resend-api-key"
SMTP_FROM="\"Mafia Club\" <noreply@mafia-club.com>"
SMTP_SECURE="false"

